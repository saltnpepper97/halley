# Halley configuration.
#
# A short starter: the settings people change first. Every other option keeps
# its default and is documented at
#   https://saltnpepper97.github.io/halley-site/wiki/config
# examples/halley.reference.rune in the Halley repository lists them all.
#
#   halleyctl config edit     open this file in $VISUAL or $EDITOR
#   halleyctl config verify   check it for mistakes
#
# Valid saves apply immediately. An invalid save is rejected and the last
# valid configuration stays active. Halley never rewrites this file.

# Programs to start with the session.
# More: https://saltnpepper97.github.io/halley-site/wiki/config/autostart
autostart:
  # once "waybar"
  # once "mako"
end

# More: https://saltnpepper97.github.io/halley-site/wiki/config/input
input:
  # "click" focuses a window when you click it; "hover" when the pointer
  # enters it.
  focus-mode "click"

  keyboard:
    layout "us"
  end
end

# More: https://saltnpepper97.github.io/halley-site/wiki/config/cursor
cursor:
  theme "default"
  size 24
end

# More: https://saltnpepper97.github.io/halley-site/wiki/config/decorations
decorations:
  border:
    colour-focused "#f4f5f7"
    colour-unfocused "#474d59"
  end

  titlebars:
    enabled true
  end
end

# The font for Halley's own labels, cards and notices.
# More: https://saltnpepper97.github.io/halley-site/wiki/config/font
font:
  family "monospace"
  size 11
end

# Windows you stop using collapse into nodes after a while: the first delay
# applies to windows mostly off screen, the second to windows you can see. Mod+N collapses or restores a window yourself.
# More: https://saltnpepper97.github.io/halley-site/wiki/config/decay
decay:
  enabled true
  outside-delay-seconds 600
  inside-delay-seconds 5400
end

# More: https://saltnpepper97.github.io/halley-site/wiki/config/screenshot
screenshot:
  directory "$env.HOME/Pictures/Screenshots"
end

# Halley animates opening, closing, fullscreen, tidy and nodes. Set
# `enabled false` to switch every animation off at once.
# More: https://saltnpepper97.github.io/halley-site/wiki/config/animations
animations:
  enabled true

  window-open:
    # "center-out", "fade", or "launch" (an arc from where it was launched).
    type "center-out"
    duration-ms 300
  end

  window-close:
    # "shrink", "fade", or "retract".
    type "shrink"
    duration-ms 270
  end

  fullscreen:
    motion "spring"
    damping-ratio 1.0
    stiffness 800.0
  end
end

# Everything else keeps its default, documented at the link above:
# wallpaper, effects (blur and shadows), overlays, field, node, clusters,
# bearings, trail, physics, placement, rules, view and debug.

# Bindings. This list replaces Halley's built-in bindings rather than adding
# to them, so a binding removed here is unbound.
# More: https://saltnpepper97.github.io/halley-site/wiki/config/keybinds
keybinds:
  # The key `$var.mod` stands for: "super", "alt", "ctrl" or "shift".
  mod "super"

  # Basics. `quit` asks before leaving.
  "$var.mod+shift+e" "quit"
  "$var.mod+q" "close-focused"
  "$var.mod+f" "toggle-fullscreen"
  "$var.mod+m" "maximize-focused"
  "$var.mod+n" "toggle-state"
  "$var.mod+p" "toggle-focused-pin"
  "$var.mod+shift+r" "reload"

  # Launch. `default-terminal` opens the first terminal it finds; Lift is
  # Halley's launcher, installed separately.
  "$var.mod+t" "default-terminal"
  "$var.mod+d" "halley-lift"

  # Tidy the visible windows into a mosaic; press again to undo.
  "$var.mod+a" "tidy"

  # Finding things: zoom-fit zooms out to show everything, Bearings points to
  # what is off screen, Alt+Tab and the Trail walk recent windows.
  "$var.mod+o" "zoom-fit"
  "$var.mod+z" "bearings-show"
  "$var.mod+shift+z" "bearings-toggle"
  "alt+tab" "cycle-focus"
  "alt+shift+tab" "cycle-focus-backward"
  "$var.mod+h" "center-last-focused"
  "$var.mod+comma" "trail-prev"
  "$var.mod+period" "trail-next"

  # Focus the nearest window in a direction.
  "$var.mod+left" "focus-left"
  "$var.mod+right" "focus-right"
  "$var.mod+up" "focus-up"
  "$var.mod+down" "focus-down"

  # Focus the next monitor in a direction.
  "$var.mod+shift+left" "monitor-focus left"
  "$var.mod+shift+right" "monitor-focus right"
  "$var.mod+shift+up" "monitor-focus up"
  "$var.mod+shift+down" "monitor-focus down"

  # Resize the focused window on the Field, or swap tiles inside a cluster.
  "$var.mod+ctrl+left" "cluster-tile-swap-left" with scope "tile"
  "$var.mod+ctrl+right" "cluster-tile-swap-right" with scope "tile"
  "$var.mod+ctrl+up" "cluster-tile-swap-up" with scope "tile"
  "$var.mod+ctrl+down" "cluster-tile-swap-down" with scope "tile"
  "$var.mod+ctrl+left" "resize-window-left" with scope "field"
  "$var.mod+ctrl+right" "resize-window-right" with scope "field"
  "$var.mod+ctrl+up" "resize-window-up" with scope "field"
  "$var.mod+ctrl+down" "resize-window-down" with scope "field"

  # Clusters are optional named groups of windows. Make one, change its
  # layout, float a member, or open one by slot (0 is slot 10).
  "$var.mod+shift+c" "cluster-mode"
  "$var.mod+l" "cluster-layout-cycle"
  "$var.mod+v" "cluster-toggle-float"
  "$var.mod+1" "cluster-slot-1"
  "$var.mod+2" "cluster-slot-2"
  "$var.mod+3" "cluster-slot-3"
  "$var.mod+4" "cluster-slot-4"
  "$var.mod+5" "cluster-slot-5"
  "$var.mod+6" "cluster-slot-6"
  "$var.mod+7" "cluster-slot-7"
  "$var.mod+8" "cluster-slot-8"
  "$var.mod+9" "cluster-slot-9"
  "$var.mod+0" "cluster-slot-10"

  # Zoom the Field out, in, or back to normal.
  "$var.mod+minus" "zoom-out"
  "$var.mod+equal" "zoom-in"
  "$var.mod+shift+0" "zoom-reset"

  "Print" "screenshot"

  # Anything that is not a built-in action runs as a command.
  "XF86AudioRaiseVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0" with repeat true
  "XF86AudioLowerVolume" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" with repeat true
  "XF86AudioMute" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

  # Mouse: Mod+drag moves a window, Mod+right-drag resizes it,
  # Mod+Shift+drag pans while carrying it, and dragging empty Field pans.
  "$var.mod+click-left" "move-window"
  "$var.mod+click-right" "resize-window"
  "$var.mod+shift+click-left" "drag-pan"
  "click-left" "pan-field"
end
